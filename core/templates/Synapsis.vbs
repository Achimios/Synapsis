' Synapsis launcher for this project (generated by: node core/cli.js init). Keep this file pure ASCII.
' Double-click: open this folder as a workspace in the Synapsis desktop app (fallback: dev server + browser).
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
ws = fso.GetParentFolderName(WScript.ScriptFullName)
syn = "{{SYNAPSIS_HOME}}"
port = "5410"

' Prefer the desktop app (tray, own window). Single instance: if it is already running it just opens this workspace.
exe = syn & "\app\node_modules\electron\dist\electron.exe"
If fso.FileExists(exe) Then
  sh.Run """" & exe & """ """ & syn & "\app\electron\main.mjs"" --ws """ & ws & """", 1, False
  WScript.Quit
End If

' Fallback: dev server + browser

running = False
On Error Resume Next
Set http = CreateObject("MSXML2.ServerXMLHTTP")
http.setTimeouts 500, 500, 500, 500
http.Open "GET", "http://localhost:" & port & "/__alive", False
http.Send
If Err.Number = 0 Then If http.Status = 200 Then running = True
On Error GoTo 0

If Not running Then
  If Not fso.FolderExists(syn & "\app") Then
    MsgBox "Synapsis not found at " & syn & vbCrLf & "Moved? Re-run: node core/cli.js init <this folder>", 48, "Synapsis"
    WScript.Quit
  End If
  sh.CurrentDirectory = syn & "\app"
  If Not fso.FolderExists(syn & "\app\node_modules") Then sh.Run "cmd /c npm install", 0, True
  sh.Run "cmd /c npm run dev", 0, False
  WScript.Sleep 2500
End If

sh.Run "http://localhost:" & port & "/?ws=" & UrlEncodeUtf8(ws)

' VBScript's Escape() gives %uXXXX for non-ASCII (browsers do not decode it) -> encode UTF-8 bytes by hand
Function UrlEncodeUtf8(s)
  Dim st, bytes, i, b, out
  Set st = CreateObject("ADODB.Stream")
  st.Type = 2: st.Charset = "utf-8": st.Open: st.WriteText s
  st.Position = 0: st.Type = 1: st.Position = 3 ' skip BOM
  bytes = st.Read: st.Close
  out = ""
  For i = 1 To LenB(bytes)
    b = AscB(MidB(bytes, i, 1))
    If (b >= 48 And b <= 57) Or (b >= 65 And b <= 90) Or (b >= 97 And b <= 122) Or b = 45 Or b = 46 Or b = 95 Then
      out = out & Chr(b)
    Else
      out = out & "%" & Right("0" & Hex(b), 2)
    End If
  Next
  UrlEncodeUtf8 = out
End Function
